@startuml Smart Band Edge Service - Class Diagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false

' Define packages for bounded contexts
package "Health Bounded Context" #DEEAFF {
  ' Domain Layer
  package "domain" #E2F0FF {
    class HealthRecord {
      id: int | None
      submitting_device: SubmittingDevice
      event_id: TelemetryEventId
      heart_rate: HeartRateBpm
      recorded_at: RecordedAt
      timestamp_supplied: bool
      +record(submitting_device, event_id, bpm, created_at): HealthRecord
      +with_persistence_id(id): HealthRecord
    }

    class SubmittingDevice {
      device_id: str
    }

    class HeartRateBpm {
      value: float
      +__init__(value)
    }

    class RecordedAt {
      value: datetime
      +__init__(value)
      +now(): RecordedAt
    }

    class TelemetryEventId {
      value: str
      +__init__(value)
    }
  }

  ' Application Layer
  package "application" #D5E7FF {
    class HealthRecordApplicationService {
      -health_record_repository: HealthRecordRepository
      -iam_anti_corruption_layer: IamAntiCorruptionLayer
      +__init__()
      +create_health_record(device_id, event_id, bpm, created_at, api_key): HealthRecordSaveResult
    }
  }

  ' Context integration
  package "integration" #DCE8F5 {
    class IamAntiCorruptionLayer {
      -iam_authentication_service: AuthApplicationService
      +authenticated_submitting_device(device_id, credential): SubmittingDevice
    }
  }

  ' Infrastructure Layer
  package "infrastructure" #C9DFFF {
    class HealthRecordModel {
      id: AutoField
      device_id: CharField
      event_id: CharField
      bpm: FloatField
      created_at: DateTimeField
      timestamp_supplied: BooleanField
    }

    class HealthRecordRepository {
      +save_idempotently(health_record): HealthRecordSaveResult
    }
  }

  ' Interface Layer
  package "interfaces" #BCCEFF {
    class health_api {
      +create_health_record(): tuple
    }
  }
}

package "IAM Bounded Context" #FFEBDE {
  ' Domain Layer
  package "domain" #FFF2E8 {
    class Device {
      device_id: str
      credential: ApiCredential
      created_at: datetime
      revoked_at: datetime | None
      +register(device_id, api_key): Device
      +authenticate(api_key): bool
      +revoke(): Device
      +rotate_api_key(new_api_key): Device
    }

    class ApiCredential {
      salt: bytes
      digest: bytes
      iterations: int
      +create(secret): ApiCredential
      +matches(secret): bool
    }
  }

  ' Application Layer
  package "application" #FFE6D5 {
    class AuthApplicationService {
      -device_repository: DeviceRepository
      +__init__()
      +authenticate(device_id, api_key): bool
      +register_device(device_id, api_key): Device
      +rotate_api_key(device_id, new_api_key): Device
      +revoke_device(device_id): Device
      +get_or_create_test_device(): Device
    }
  }

  ' Infrastructure Layer
  package "infrastructure" #FFDAC1 {
    class DeviceModel {
      device_id: CharField
      credential_verifier: CharField
      created_at: DateTimeField
      revoked_at: DateTimeField
    }

    class DeviceRepository {
      +find_by_device_id(device_id): Device
      +save(device): Device
      +get_or_create_test_device(): Device
    }
  }

  ' Interface Layer
  package "interfaces" #FFCEAE {
    class iam_api {
      +authenticate_request(): tuple
    }
  }
}

package "Shared Components" #E8FFE8 {
  package "infrastructure" #D1FFD1 {
    class db {
      +connect()
      +create_tables()
      +close()
    }

    class init_db {
      +init_db()
    }
  }
}

' Main application
class app {
  +setup()
  +run()
}

' Relationships

' Health bounded context relationships
HealthRecordApplicationService --> HealthRecordRepository: uses
HealthRecordApplicationService --> IamAntiCorruptionLayer: uses
HealthRecordRepository --> HealthRecordModel: uses
HealthRecordRepository ..> HealthRecord: creates
HealthRecord ..> HeartRateBpm: validates
HealthRecord ..> RecordedAt: normalizes
HealthRecord ..> TelemetryEventId: identifies telemetry
health_api --> HealthRecordApplicationService: uses
IamAntiCorruptionLayer ..> SubmittingDevice: translates to

' IAM bounded context relationships
AuthApplicationService --> DeviceRepository: uses
DeviceRepository --> DeviceModel: uses
DeviceRepository ..> Device: creates
Device ..> ApiCredential: verifies
Device --> ApiCredential: owns
iam_api --> AuthApplicationService: uses

' Cross-context relationships
IamAntiCorruptionLayer ..> AuthApplicationService: translates IAM result
app ..> IamAntiCorruptionLayer: composes Health with IAM

' Database relationships
HealthRecordModel --> db: uses
DeviceModel --> db: uses
init_db ..> HealthRecordModel: creates tables
init_db ..> DeviceModel: creates tables
app ..> init_db: initializes
app ..> health_api: registers
app ..> iam_api: registers

@enduml